APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hayat_studio
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# First admin (created by `python -m app.seed` if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_NOTIFY_EMAIL=admin@example.com

# Email (Resend). Leave key empty in dev to log emails to console.
RESEND_API_KEY=
EMAIL_FROM=Abdullah Hayat <onboarding@resend.dev>

# Storage: local | s3 | cloudinary   (s3 also covers Cloudflare R2 via S3_ENDPOINT_URL)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_URL=
MAX_UPLOAD_MB=15
